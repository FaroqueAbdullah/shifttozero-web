# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity (public dataset; content only)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Optional: Viewer token, only needed for draft previews
SANITY_API_READ_TOKEN=
# Temporary Editor token for `npm run seed` only. Delete after seeding.
SANITY_API_WRITE_TOKEN=
# Shared secret configured on the Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# Neon Postgres (submissions)
DATABASE_URL=

# Auth.js (generate with: npx auth secret)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed when self-hosting / running `next start` locally (Vercel sets this automatically)
# AUTH_TRUST_HOST=true
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
