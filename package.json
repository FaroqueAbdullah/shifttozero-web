    "seed": "node scripts/seed/seed.mjs",
    "seed:delete": "node scripts/seed/seed.mjs --delete"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.18.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "material-symbols": "^0.48.0",
    "motion": "^14.3.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "next-sanity": "^13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "sanity": "^6.18.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
